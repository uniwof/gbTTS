<Project Sdk="Microsoft.NET.Sdk">
  <!-- P0：xUnit 自动测试（xUnit = Apache-2.0）。只测 Core（不含界面），Linux / Windows 都能跑：dotnet test -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/CaretReader.Core/CaretReader.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../corpus/*.tsv" Link="corpus/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup><None Include="../golden.tsv" Link="golden.tsv" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
</Project>
